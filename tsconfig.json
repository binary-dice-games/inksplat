{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": false,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": [
    "packages/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "viewer/**/*.ts",
    "support-app/**/*.ts"
  ],
  "exclude": ["node_modules", "build"]
}
